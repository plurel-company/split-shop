{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "splitshop-brand-preview",
  "main": "cloudflare/brand-preview-worker.mjs",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist/brand-preview/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": false }
}
