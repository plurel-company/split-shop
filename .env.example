# Local standalone Next.js development. Never commit real secrets.
# Integrated production uses DEMO_SHOP_* on the main Worker; see README.
NEXT_PUBLIC_PLUREL_MERCHANT_ID=plurel_merch_your_id
NEXT_PUBLIC_PLUREL_PUBLISHABLE_KEY_TEST=plurel_pk_test_your_key
PLUREL_SECRET_KEY_TEST=plurel_sk_test_your_key
PLUREL_SIGNING_SECRET=plurel_sign_your_secret
PLUREL_WEBHOOK_SECRET_TEST=whsec_your_test_secret
NEXT_PUBLIC_SITE_URL=http://localhost:3001
PLUREL_API_BASE=http://localhost:3000/api/v1
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# Optional error reporting
# NEXT_PUBLIC_SENTRY_DSN=https://example.ingest.sentry.io/example
# SENTRY_DSN=https://example.ingest.sentry.io/example
# Legacy ANTE_* sandbox aliases remain supported in standalone development.
